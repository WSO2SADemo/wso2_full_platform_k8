		{
			"name": "7. MCP Auth (Get Access Token)",
			"item": [
				{
					"name": "Get Access Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set('access_token', jsonData.access_token);",
									"    pm.test('Token obtained', function() { pm.expect(jsonData.access_token).to.be.a('string'); });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{apim_host}}/oauth2/token",
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{consumer_key}}"
								},
