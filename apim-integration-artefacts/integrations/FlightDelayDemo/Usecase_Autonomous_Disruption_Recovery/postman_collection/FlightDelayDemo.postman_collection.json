		{
			"name": "4. Full ADR Recovery (THE MAIN DEMO)",
			"item": [
				{
					"name": "4.1 ⚡ TRIGGER AUTONOMOUS RECOVERY",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"flightId\": \"FL001\",\n    \"disruptionType\": \"DELAY\"\n}"
						},
						"url": {
							"raw": "{{orchestrator_host}}/adr/recover",
							"host": [
								"{{orchestrator_host}}"
							],
							"path": [
								"adr",
								"recover"
							]
						},
						"description": "⚡ THE MAIN DEMO ENDPOINT ⚡\n\nThis triggers the full Autonomous Disruption Recovery:\n\n1. Disruption Detection Service identifies the delay and affected passengers\n2. Crew Service checks duty hour compliance for all assigned crew\n3. Passenger Service rebooks passengers (VIPs first), sends notifications, and determines context-aware compensation\n4. Logistics Service reassigns gates, redirects catering, and creates ground handling tasks\n5. ADR Orchestrator produces a unified Recovery Plan with full negotiation log\n\nThe response includes the complete negotiation_log showing how services collaborated in milliseconds."
					}
				},
				{
					"name": "4.2 Get All Recovery Plans",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{orchestrator_host}}/adr/recovery-plans",
							"host": [
								"{{orchestrator_host}}"
							],
							"path": [
								"adr",
								"recovery-plans"
							]
						},
						"description": "List all recovery plans generated by the ADR system."
					}
				}
			]
		},
