						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"delayMinutes\": 120,\n    \"reason\": \"Severe weather at London Heathrow — thunderstorm and reduced visibility\"\n}"
						},
						"url": {
							"raw": "{{disruption_host}}/disruption/flights/FL001/delay",
							"host": [
								"{{disruption_host}}"
							],
							"path": [
								"disruption",
								"flights",
								"FL001",
								"delay"
							]
						},
						"description": "Report a 2-hour delay on FL001 (BA256 LHR→JFK). This creates a HIGH severity disruption affecting 312 passengers."
					}
				},
				{
					"name": "2.2 Verify Active Disruptions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
